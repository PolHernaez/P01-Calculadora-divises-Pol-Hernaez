<?xml version="1.0" encoding="utf-8"?>
<!-- Moneda triada: camp pla clar amb text negre -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cream_pressed" />
            <corners android:radius="@dimen/radius_key" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <corners android:radius="@dimen/radius_key" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_700" />
            <stroke android:width="1.5dp" android:color="@color/red" />
            <corners android:radius="@dimen/radius_key" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/ink_500" />
            <corners android:radius="@dimen/radius_key" />
        </shape>
    </item>
</selector>
