<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    tools:context=".MainActivity">

    <!-- Columnes: marges laterals i les 4 columnes del teclat -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gCol1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.275" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gCol2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gCol3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.725" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <!-- Files: pantalles, selector i teclat -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gEurosTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.12" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gEurosBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.25" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gChipsTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.27" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gChipsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.335" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gResultTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.355" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gResultBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRow0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.525" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRow1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.6375" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRow2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.75" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRow3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.8625" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gRow4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.975" />

    <!-- Capçalera -->
    <TextView
        android:id="@+id/tvTitle"
        style="@style/Text.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:text="@string/title"
        app:layout_constraintBottom_toTopOf="@id/tvSubtitle"
        app:layout_constraintEnd_toStartOf="@id/ivTally"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- Detall decoratiu: tres ratlles -->
    <ImageView
        android:id="@+id/ivTally"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/key_margin"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:srcCompat="@drawable/ic_tally" />

    <TextView
        android:id="@+id/tvSubtitle"
        style="@style/Text.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/subtitle"
        app:layout_constraintBottom_toTopOf="@id/gEurosTop"
        app:layout_constraintEnd_toEndOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="@id/tvTitle"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Pantalla dels euros -->
    <View
        android:id="@+id/vEurosCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:background="@drawable/bg_display_euros"
        app:layout_constraintBottom_toTopOf="@id/gEurosBottom"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gEurosTop" />

    <TextView
        android:id="@+id/tvEurosLabel"
        style="@style/Text.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginTop="@dimen/card_padding"
        android:text="@string/label_euros"
        app:layout_constraintStart_toStartOf="@id/vEurosCard"
        app:layout_constraintTop_toTopOf="@id/vEurosCard" />

    <TextView
        android:id="@+id/tvEuros"
        style="@style/Text.Display.Euros"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/card_padding"
        android:accessibilityLiveRegion="polite"
        android:text="@string/initial_euros"
        app:layout_constraintBottom_toBottomOf="@id/vEurosCard"
        app:layout_constraintEnd_toEndOf="@id/vEurosCard"
        app:layout_constraintStart_toStartOf="@id/vEurosCard"
        app:layout_constraintTop_toBottomOf="@id/tvEurosLabel" />

    <!-- Selector de moneda: cadena de 4 amb la mateixa amplada -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPound"
        style="@style/Widget.Chip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:contentDescription="@string/cd_pound"
        android:text="@string/currency_pound"
        app:layout_constraintBottom_toTopOf="@id/gChipsBottom"
        app:layout_constraintEnd_toStartOf="@id/btnDollar"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gChipsTop" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDollar"
        style="@style/Widget.Chip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:contentDescription="@string/cd_dollar"
        android:text="@string/currency_dollar"
        app:layout_constraintBottom_toTopOf="@id/gChipsBottom"
        app:layout_constraintEnd_toStartOf="@id/btnYen"
        app:layout_constraintStart_toEndOf="@id/btnPound"
        app:layout_constraintTop_toBottomOf="@id/gChipsTop" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnYen"
        style="@style/Widget.Chip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:contentDescription="@string/cd_yen"
        android:text="@string/currency_yen"
        app:layout_constraintBottom_toTopOf="@id/gChipsBottom"
        app:layout_constraintEnd_toStartOf="@id/btnYuan"
        app:layout_constraintStart_toEndOf="@id/btnDollar"
        app:layout_constraintTop_toBottomOf="@id/gChipsTop" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnYuan"
        style="@style/Widget.Chip"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:contentDescription="@string/cd_yuan"
        android:text="@string/currency_yuan"
        app:layout_constraintBottom_toTopOf="@id/gChipsBottom"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintStart_toEndOf="@id/btnYen"
        app:layout_constraintTop_toBottomOf="@id/gChipsTop" />

    <!-- Pantalla del resultat (estil rebut de canvi) -->
    <View
        android:id="@+id/vResultCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/key_margin"
        android:background="@drawable/bg_display_result"
        app:layout_constraintBottom_toTopOf="@id/gResultBottom"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gResultTop" />

    <TextView
        android:id="@+id/tvResultLabel"
        style="@style/Text.Label.OnPaper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/card_padding"
        android:layout_marginTop="@dimen/card_padding"
        android:text="@string/label_result"
        app:layout_constraintStart_toStartOf="@id/vResultCard"
        app:layout_constraintTop_toTopOf="@id/vResultCard" />

    <View
        android:id="@+id/vResultDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/key_margin"
        android:layout_marginHorizontal="@dimen/card_padding"
        android:layout_marginTop="@dimen/key_margin"
        android:background="@drawable/line_dashed"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@id/vResultCard"
        app:layout_constraintStart_toStartOf="@id/vResultCard"
        app:layout_constraintTop_toBottomOf="@id/tvResultLabel" />

    <TextView
        android:id="@+id/tvResult"
        style="@style/Text.Display.Result"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/card_padding"
        android:accessibilityLiveRegion="polite"
        android:text="@string/initial_result"
        app:layout_constraintBottom_toBottomOf="@id/vResultCard"
        app:layout_constraintEnd_toEndOf="@id/vResultCard"
        app:layout_constraintStart_toStartOf="@id/vResultCard"
        app:layout_constraintTop_toBottomOf="@id/vResultDivider" />

    <!-- Teclat: fila 1 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn7"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_7"
        app:layout_constraintBottom_toTopOf="@id/gRow1"
        app:layout_constraintEnd_toStartOf="@id/gCol1"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gRow0" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn8"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_8"
        app:layout_constraintBottom_toTopOf="@id/gRow1"
        app:layout_constraintEnd_toStartOf="@id/gCol2"
        app:layout_constraintStart_toEndOf="@id/gCol1"
        app:layout_constraintTop_toBottomOf="@id/gRow0" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn9"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_9"
        app:layout_constraintBottom_toTopOf="@id/gRow1"
        app:layout_constraintEnd_toStartOf="@id/gCol3"
        app:layout_constraintStart_toEndOf="@id/gCol2"
        app:layout_constraintTop_toBottomOf="@id/gRow0" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCE"
        style="@style/Widget.Key.Action"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:contentDescription="@string/cd_clear"
        android:text="@string/key_ce"
        app:layout_constraintBottom_toTopOf="@id/gRow1"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintStart_toEndOf="@id/gCol3"
        app:layout_constraintTop_toBottomOf="@id/gRow0" />

    <!-- Fila 2 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn4"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_4"
        app:layout_constraintBottom_toTopOf="@id/gRow2"
        app:layout_constraintEnd_toStartOf="@id/gCol1"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gRow1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn5"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_5"
        app:layout_constraintBottom_toTopOf="@id/gRow2"
        app:layout_constraintEnd_toStartOf="@id/gCol2"
        app:layout_constraintStart_toEndOf="@id/gCol1"
        app:layout_constraintTop_toBottomOf="@id/gRow1" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn6"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_6"
        app:layout_constraintBottom_toTopOf="@id/gRow2"
        app:layout_constraintEnd_toStartOf="@id/gCol3"
        app:layout_constraintStart_toEndOf="@id/gCol2"
        app:layout_constraintTop_toBottomOf="@id/gRow1" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnBack"
        style="@style/Widget.KeyIcon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:contentDescription="@string/cd_back"
        app:srcCompat="@drawable/ic_backspace"
        app:layout_constraintBottom_toTopOf="@id/gRow2"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintStart_toEndOf="@id/gCol3"
        app:layout_constraintTop_toBottomOf="@id/gRow1" />

    <!-- Fila 3 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn1"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_1"
        app:layout_constraintBottom_toTopOf="@id/gRow3"
        app:layout_constraintEnd_toStartOf="@id/gCol1"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gRow2" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn2"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_2"
        app:layout_constraintBottom_toTopOf="@id/gRow3"
        app:layout_constraintEnd_toStartOf="@id/gCol2"
        app:layout_constraintStart_toEndOf="@id/gCol1"
        app:layout_constraintTop_toBottomOf="@id/gRow2" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn3"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_3"
        app:layout_constraintBottom_toTopOf="@id/gRow3"
        app:layout_constraintEnd_toStartOf="@id/gCol3"
        app:layout_constraintStart_toEndOf="@id/gCol2"
        app:layout_constraintTop_toBottomOf="@id/gRow2" />

    <!-- El = ocupa dues files per destacar -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEquals"
        style="@style/Widget.Key.Equals"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:contentDescription="@string/cd_equals"
        android:text="@string/key_equals"
        app:layout_constraintBottom_toTopOf="@id/gRow4"
        app:layout_constraintEnd_toStartOf="@id/gEnd"
        app:layout_constraintStart_toEndOf="@id/gCol3"
        app:layout_constraintTop_toBottomOf="@id/gRow2" />

    <!-- Fila 4 -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn0"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:text="@string/key_0"
        app:layout_constraintBottom_toTopOf="@id/gRow4"
        app:layout_constraintEnd_toStartOf="@id/gCol2"
        app:layout_constraintStart_toEndOf="@id/gStart"
        app:layout_constraintTop_toBottomOf="@id/gRow3" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnComma"
        style="@style/Widget.Key.Number"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/key_margin"
        android:contentDescription="@string/cd_comma"
        android:text="@string/key_comma"
        app:layout_constraintBottom_toTopOf="@id/gRow4"
        app:layout_constraintEnd_toStartOf="@id/gCol3"
        app:layout_constraintStart_toEndOf="@id/gCol2"
        app:layout_constraintTop_toBottomOf="@id/gRow3" />

</androidx.constraintlayout.widget.ConstraintLayout>
