<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Textos: lletra estreta i pesada, com els títols d'un cartell -->
    <style name="Text.Title" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="Text.Subtitle" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Label" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <style name="Text.Label.OnPaper">
        <item name="android:textColor">@color/paper_muted</item>
    </style>

    <!-- Les pantalles encongeixen el text si el número no hi cap -->
    <style name="Text.Display" parent="">
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">20sp</item>
        <item name="autoSizeStepGranularity">2sp</item>
    </style>

    <style name="Text.Display.Euros">
        <item name="android:textColor">@color/text_primary</item>
        <item name="autoSizeMaxTextSize">56sp</item>
    </style>

    <style name="Text.Display.Result">
        <item name="android:textColor">@color/paper_text</item>
        <item name="autoSizeMaxTextSize">64sp</item>
    </style>

    <!-- Tecles: plans, sense ombra; el canvi de color en prémer fa de feedback -->
    <style name="Widget.Key" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="Widget.Key.Number">
        <item name="android:background">@drawable/bg_key_number</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Key.Action">
        <item name="android:background">@drawable/bg_key_action</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Widget.Key.Equals">
        <item name="android:background">@drawable/bg_key_equals</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="Widget.KeyIcon" parent="Widget.AppCompat.ImageButton">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:background">@drawable/bg_key_action</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- Selector de moneda -->
    <style name="Widget.Chip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">@dimen/touch_min</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
    </style>
</resources>
